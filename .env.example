# GEMINI_API_KEY: Server-side API key for Gemini structured message extraction, screenshot OCR, and optional ASR/TTS.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM_PROVIDER_ORDER: Comma-separated LLM provider fallback order (gemini,none).
LLM_PROVIDER_ORDER="gemini,none"

# LLM_MODEL: Model ID used by the Gemini provider (defaults to gemini-4-hydrogen; never hard-coded).
LLM_MODEL="gemini-4-hydrogen"

# EXPLAIN_WITH_LLM: Keep false so only vetted Telugu/English reason templates reach users.
EXPLAIN_WITH_LLM="false"

# ASR_PROVIDER_ORDER: Comma-separated server/client ASR order (sarvam,bhashini,gemini,webspeech).
ASR_PROVIDER_ORDER="sarvam,bhashini,gemini,webspeech"

# TTS_PROVIDER_ORDER: Comma-separated TTS order (prerecorded,sarvam,bhashini,speechSynthesis).
TTS_PROVIDER_ORDER="prerecorded,sarvam,bhashini,speechSynthesis"

# SARVAM_API_KEY: Optional Sarvam AI API key for Telugu ASR and TTS.
SARVAM_API_KEY=""

# BHASHINI_USER_ID: Optional registered Bhashini user ID (never assumed present).
BHASHINI_USER_ID=""

# BHASHINI_API_KEY: Optional Bhashini ULCA API key.
BHASHINI_API_KEY=""

# BHASHINI_PIPELINE_ID: Optional Bhashini inference pipeline ID.
BHASHINI_PIPELINE_ID=""

# GOOGLE_SAFE_BROWSING_KEY: Optional Google Safe Browsing v4 API key for H10 flag checks.
GOOGLE_SAFE_BROWSING_KEY=""

# SUPABASE_URL: Optional Supabase project URL; when absent, server runs in seeded memory mode.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Optional server-only Supabase service role key (never exposed to client).
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN_PASSWORD: Password for /admin registry editor and radar CSV export (constant-time verified).
ADMIN_PASSWORD="change-me-before-demo"

# ADMIN_SESSION_SECRET: HMAC secret used to sign httpOnly admin session cookies.
ADMIN_SESSION_SECRET="replace-with-32-byte-random-secret"

# RADAR_MIN_COUNT: Minimum reports required before displaying a real (non-sample) radar cluster.
RADAR_MIN_COUNT="3"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"
